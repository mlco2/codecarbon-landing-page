---
import { highlightCode } from "../utils/highlightCode";

const {
  title,
  language,
  filename,
  code,
  docsUrl,
  exampleId,
  hidden = false,
  compact = false,
} = Astro.props;

const highlighted = await highlightCode(code, language);
---

<article
  data-code-example={exampleId}
  class:list={[
    "code-example flex flex-col gap-0 w-full",
    hidden && "hidden",
    compact && "compact",
  ]}
>
  <div
    class="overflow-hidden rounded-lg border-2 border-lime-300 bg-[#0d0d0d] shadow-lg"
    data-code-block
    data-copy-source={code}
  >
    <div
      class="flex items-center justify-between gap-3 border-b border-lime-300/30 bg-black px-4 py-2.5"
    >
      <div class="flex min-w-0 items-center gap-3">
        <span class="flex shrink-0 gap-1.5" aria-hidden="true">
          <span class="size-2.5 rounded-full bg-red-500/80"></span>
          <span class="size-2.5 rounded-full bg-yellow-500/80"></span>
          <span class="size-2.5 rounded-full bg-lime-400/80"></span>
        </span>
        <span class="truncate text-xs text-white/50">{filename}</span>
      </div>
      <div class="flex shrink-0 items-center gap-2">
        <span class="text-[10px] uppercase tracking-wider text-white/40"
          >{language}</span
        >
        <button
          type="button"
          data-copy-code
          class="rounded border border-lime-300/40 px-2 py-0.5 text-[10px] uppercase tracking-wide text-lime-300 transition hover:bg-lime-300 hover:text-black"
        >
          Copy
        </button>
      </div>
    </div>
    <div
      class:list={["code-highlight overflow-x-auto", compact ? "p-3" : "p-4"]}
      set:html={highlighted}
    />
  </div>
  {
    !compact && (
      <div class="mt-3 flex flex-wrap items-center justify-between gap-2 px-1">
        <p class="text-sm text-white/70">{title}</p>
        {docsUrl && (
          <a
            href={docsUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="text-sm text-lime-300 underline hover:text-lime-600"
          >
            Full docs →
          </a>
        )}
      </div>
    )
  }
</article>

<script>
  function initCopyButtons() {
    document.querySelectorAll("[data-copy-code]").forEach((button) => {
      if (button.dataset.copyBound) return;
      button.dataset.copyBound = "true";
      button.addEventListener("click", async () => {
        const block = button.closest("[data-code-block]");
        const code = block?.getAttribute("data-copy-source") ?? "";
        await navigator.clipboard.writeText(code);
        const label = button.textContent;
        button.textContent = "Copied!";
        window.setTimeout(() => {
          button.textContent = label;
        }, 2000);
      });
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initCopyButtons);
  } else {
    initCopyButtons();
  }
  document.addEventListener("astro:page-load", initCopyButtons);
</script>
