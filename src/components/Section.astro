---
import PageContainer from "./PageContainer.astro";

const { id, invert, compact } = Astro.props;

const padding = compact ? "py-6 lg:py-14" : "py-10 lg:py-20";
---

<section
  class:list={[
    "w-full",
    invert ? "bg-lime-300 text-black" : "text-white",
    padding,
  ]}
  id={id}
>
  <PageContainer class="flex flex-col items-center gap-2">
    <slot />
  </PageContainer>
</section>
