---
import Section from "../components/Section.astro";
import Button from "../components/Button.astro";
import GlobalIcon from "../assets/icons/Global.svg";
import {
  DOCS_URL,
  ECOLOGITS_DOCS_URL,
  NGO_URL,
} from "../consts";
import { products } from "../content/ecosystem";
---

<Section id="welcome" compact>
  <div class="flex max-w-5xl flex-col items-center gap-6 text-center">
    <GlobalIcon class="size-56 md:size-80 shrink-0" aria-hidden="true" />
    <p class="text-sm uppercase tracking-widest text-lime-300">
      mlco2 open-source ecosystem
    </p>
    <h1 class="max-w-5xl text-4xl font-bold leading-tight text-white md:text-6xl">
      Measure the environmental footprint of computing &amp; AI
    </h1>
    <p class="text-lg font-bold uppercase tracking-wide text-lime-300">
      Two tools, one mission.
    </p>
    <p class="prose max-w-2xl text-lg text-white">
      <a
        href={NGO_URL}
        class="text-lime-300 underline hover:text-lime-600"
        target="_blank"
        rel="noopener noreferrer">Code Carbon</a
      > is a French non-profit building free, open-source tools for developers and
      researchers. CodeCarbon for local compute, EcoLogits for GenAI APIs — use
      both when your stack mixes them.
    </p>

    <div class="grid w-full max-w-4xl grid-cols-1 gap-6 md:grid-cols-2">
      {
        products.map((product) => (
          <div class="flex min-h-[280px] flex-col gap-4 rounded-lg border-2 border-lime-300 bg-black/40 p-6 text-left">
            <div class="flex items-center gap-4">
              <img
                src={product.logoDark}
                alt={product.name}
                class="h-12 w-auto max-w-[180px] object-contain"
              />
              <div>
                <h2 class="text-xl font-bold text-white">{product.name}</h2>
                <p class="text-sm text-lime-300">{product.tagline}</p>
              </div>
            </div>
            <p class="prose flex-1 text-sm text-white">{product.description}</p>
            <code class="mt-auto rounded bg-lime-300/10 px-3 py-2 text-sm text-lime-300">
              {product.install}
            </code>
          </div>
        ))
      }
    </div>

    <div class="flex w-full flex-wrap items-center justify-center gap-4">
      <Button href={DOCS_URL}>CodeCarbon docs</Button>
      <Button href={ECOLOGITS_DOCS_URL}>EcoLogits docs</Button>
    </div>
  </div>
</Section>
