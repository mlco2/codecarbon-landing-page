---
import RocketIcon from "../assets/icons/business-product-startup-1.svg";
import Section from "../components/Section.astro";
import {
  ecologitsSponsors,
  founders as partnerLogos,
  sponsors as sponsorLogos,
} from "../content/partners";
import { NGO_URL } from "../consts";
---

<Section id="sponsors">
  <div class="flex flex-col items-center">
    <h2 class="text-3xl font-bold text-white uppercase max-w-3xl text-center">
      Supported by sponsors &amp; volunteers
    </h2>
    <p class="prose mt-4 max-w-2xl text-center text-white">
      Our tools stay free thanks to organisations that sponsor infrastructure,
      funding, or expertise. Community volunteers at
      <a
        href={NGO_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="text-lime-300 underline hover:text-lime-600">Code Carbon</a
      > do the rest.
    </p>

    <h3 class="text-xl font-bold text-lime-300 uppercase mt-12">CodeCarbon</h3>
    <div
      class="flex flex-wrap justify-center sm:justify-between mt-4 max-w-full overflow-x-auto"
    >
      {
        sponsorLogos.map((logo) => (
          <img
            src={logo.svg_path}
            alt={logo.name}
            class="w-40 max-h-40 object-contain m-2 flex-shrink-0"
          />
        ))
      }
    </div>

    <h3 class="text-xl font-bold text-lime-300 uppercase mt-12">EcoLogits</h3>
    <div class="flex flex-wrap justify-center mt-4 max-w-5xl gap-4">
      {
        ecologitsSponsors.map((logo) => (
          <img
            src={logo.svg_path}
            alt={logo.name}
            class="w-36 max-h-24 object-contain m-2 flex-shrink-0"
          />
        ))
      }
    </div>

    <h3 class="text-2xl font-bold text-white uppercase max-w-3xl mt-15 text-center">
      Historical research partners
    </h3>
    <div class="flex flex-wrap justify-center mt-4">
      {
        partnerLogos.map((logo) => (
          <img
            src={logo.svg_path}
            alt={logo.name}
            class="w-32 max-h-32 object-contain m-2"
          />
        ))
      }
    </div>
    <RocketIcon class="pt-8" />
  </div>
</Section>
