---
import Section from "../components/Section.astro";
import BlogTags from "../components/BlogTags.astro";
import SpreadLoveIcon from "../assets/icons/Spread-love.svg";
import CrownIcon from "../assets/icons/interface-essential-crown.svg";
import GithubIcon from "../assets/icons/social/Github.svg";
import Button from "../components/Button.astro";
import {
  GITHUB_CODECARBON_URL,
  GITHUB_ECOLOGITS_URL,
} from "../consts";
import { contributors as contributorsData } from "../content/contributors";
---

<Section id="team">
  <div class="flex flex-col md:flex-row">
    <div class="w-full md:w-2/3 order-2 md:order-1">
      <h1 class="text-4xl font-bold text-white uppercase max-w-xl">
        Maintained by volunteers across the mlco2 ecosystem
      </h1>
      <p class="prose text-white text-lg">
        CodeCarbon and EcoLogits are built by researchers, engineers, and
        sustainability practitioners who contribute in their spare time.
      </p>
      <div
        class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4 mt-8 md:pr-30"
      >
        {
          contributorsData.map((contributor) => (
            <div class="flex flex-col items-center text-center">
              <CrownIcon class="size-8 mb-2 text-lime-300" />
              {contributor.github_url ? (
                <a
                  href={contributor.github_url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="transition-opacity hover:opacity-80"
                >
                  <img
                    src={contributor.img_path}
                    alt={contributor.name}
                    class="rounded-full w-24 h-24 mb-2 grayscale"
                  />
                </a>
              ) : (
                <img
                  src={contributor.img_path}
                  alt={contributor.name}
                  class="rounded-full w-24 h-24 mb-2 grayscale"
                />
              )}
              {contributor.github_url ? (
                <h2 class="text-xl font-bold text-lime-300">
                  <a
                    href={contributor.github_url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="hover:underline"
                  >
                    {contributor.name}
                  </a>
                </h2>
              ) : (
                <h2 class="text-xl font-bold text-lime-300">
                  {contributor.name}
                </h2>
              )}
              <p class="text-lime-300">{contributor.job}</p>
              {contributor.organisation && (
                <p class="text-lime-300">{contributor.organisation}</p>
              )}
              <BlogTags tags={contributor.products} class="mt-2 justify-center" />
            </div>
          ))
        }
      </div>
      <div class="pt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
        <Button href={`${GITHUB_CODECARBON_URL}/graphs/contributors`}>
          <div class="flex items-center gap-2">
            <GithubIcon class="size-6 fill-black" /> CodeCarbon contributors
          </div>
        </Button>
        <Button href={`${GITHUB_ECOLOGITS_URL}/graphs/contributors`}>
          <div class="flex items-center gap-2">
            <GithubIcon class="size-6 fill-black" /> EcoLogits contributors
          </div>
        </Button>
      </div>
    </div>
    <div
      class="w-full md:w-1/3 flex flex-col justify-center h-full pb-10 pt-10 md:pt-40 items-center gap-2 order-1 md:order-2"
    >
      <SpreadLoveIcon class="w-60 lg:w-85 mx-auto" />
      <h1 class="text-4xl font-bold text-white uppercase max-w-lg text-center">
        Want to contribute?
      </h1>
      <p class="prose text-white">Join us and help improve the ecosystem.</p>
      <Button
        href="https://github.com/mlco2/codecarbon/blob/master/docs/how-to/contributing.md"
        ><div class="flex items-center gap-2">
          <GithubIcon class="size-6 fill-black" /> I'd love to contribute
        </div></Button
      >
    </div>
  </div>
</Section>
